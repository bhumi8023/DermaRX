# Program 89: Trapping Rainwater        
list1 = [0,1,0,2,1,0,1,3,2,1,2,1]
water = 0
left =0
right = len(list1)-1
left_wall = list1[left]
right_wall = list1[right]

for i in range(len(list1)-1):
    if list1[left] <= list1[right]:
        left += 1
        left_wall = max(left_wall,list1[left])
        water += left_wall - list1[left]
    else:
        right -= 1
        right_wall = max(right_wall,list1[right])
        water += right_wall - list1[right]
      
print(water)
