class Calculator:

    def __init__(self,number1,number2):
        self.number1 = number1
        self.number2 = number2

    def addition(self):

        try:
            result = self.number1 + self.number2
            print("The addition result is",result)

        except ArithmeticError:
            print("Sorry bro!, there is some issue")    

        except:
            print("Something is not right here")

        finally:
            print("******Code executed*******")

    def subtraction(self):
        
        try:
            result = self.number1 - self.number2
            print("The subtraction result is",result)

        except ArithmeticError:
            print("Sorry bro!, there is some issue")    
        
        except TypeError:
            print("string and number can't be subtracted")

        except:
            print("Something is not right here")          
        
        finally:
            print("******Code executed*******")        

    def multiplication(self):

        try:
            result = self.number1 * self.number2
            print("The multiplication result is",result)

        except TypeError:
             print("string and number can't multiply")   

        except:
            print("Something is not right here")
            
        finally:
            print("******Code executed*******")

    def division(self):
                
        try:
            result = self.number1 / self.number2
            print("The division result is",result)

        except ArithmeticError:  
            print("Sorry bro!, there is some issue")     

        except TypeError:
            print("string and number can't divide")     
                
        except:
            print("Something is not right here")
                
        finally:
            print("******Code executed*******")         

    def modulor(self):
                    
        try:
            result = self.number1 % self.number2
            print("The division result is",result)
    
        except ArithmeticError:  
            print("Sorry bro!, there is some issue")    

        except TypeError:
            print("string and number can't divide")  

        except:
            print("Something is not right here")
                    
        finally:
            print("******Code executed*******")  


number1 = input("Enter the number1: ")
