# prime index sum calculation
class Prime:

    def __init__(self,x,y):
        
        self.x = x
        self.y = y

    def calculation(self): 
        
        index = 2
        count = 0
        a_value = 0
        b_value = 0

        while count < self.y:
            if index == 0:
                count += 1
                if count != self.x:
                 a_value = index
            
            index +=1
            continue

        for i in range(2,index):
            if index %i==0:
                break
            elif i==index-1:
                if count == self.x:
                    a_value = index

                    if count == self.y:
                        b_value = index

        index +=1 
        
        print("Number Calculated: ",a_value + b_value - 1)
